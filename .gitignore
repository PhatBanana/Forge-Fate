# Scratch from data-pipeline runs. The audit's real fixtures live in
# src/data/srd/; anything a one-off analysis leaves in the root is working
# out loud, not part of the app, and does not belong in the history.
/gap_analysis*.json
/open5e_raw_data.json
/local_parsed_data.json
/parsed_classes.json
/subclass_*.json
/subclass_features_new.ts

# Local notes-to-self (the relay wizard records the deployed URL here)
.env

# Wrangler's build scratch. `wrangler deploy` bundles the worker into
# relay/.wrangler/tmp/ on the way out; it is the same source that is
# already committed, rebuilt per deploy under a random directory name.
.wrangler/

